# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/skillgo

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRE=30d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5121

# NVIDIA NIM API Configuration
# Get an API key from https://build.nvidia.com and paste it below.
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: a GitHub personal access token raises the API rate limit while
# verifying proof-of-work repositories. Leave blank to use anonymous access.
GITHUB_TOKEN=your_github_personal_access_token_here